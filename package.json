{
  "name": "nt",
  "description": "Read, make, write, and hash check torrent files",
  "keywords": [
    "torrent",
    "bittorremt",
    "file"
  ],
  "version": "0.7.1",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/node-torrent.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "nyc --extension .ts --reporter=lcov --reporter=text-summary npm run test:unit",
    "test:unit": "mocha --require ts-node/register test/*-test.ts"
  },
  "dependencies": {
    "async": "^3.2.0",
    "bncode": "~0.5.2",
    "buffers": "~0.1.1",
    "memorystream": "~0.3.1",
    "ordered-emitter": "^1.0.0",
    "streamspeed": "~2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "chai": "6.2.1",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=6"
  },
  "license": "MIT"
}
